# Igra Sentinel Stack — production-shaped template (no secrets)
# Copy non-secret values to host env / secret manager. NEVER place private keys on host02/host03
# or under /etc/igra-sentinel or /etc/kaspa-integrator.

SENTINEL_NETWORK_PROFILE=galleon-testnet

GALLEON_RPC=https://galleon-testnet.igralabs.com:8545
GALLEON_CHAIN_ID=38836

IGRA_MAINNET_RPC=https://rpc.igralabs.com:8545
IGRA_MAINNET_CHAIN_ID=38833

# WALLETCONNECT_PROJECT_ID=

SENTINEL_MAX_GAS_GWEI=250
SENTINEL_PUBLIC_ORIGIN=https://sentinel.tuce.app
SENTINEL_POST_RATE_LIMIT=30
SENTINEL_POST_RATE_WINDOW=60
SENTINEL_TRUST_PROXY=1

SENTINEL_API_HOST=127.0.0.1
SENTINEL_API_PORT=8790

# Public role addresses only (private keys stay off VPS — local kaspa.wallets.local.env for rehearsal)
GALLEON_PROTOCOL_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
GALLEON_LP_REWARDS_POOL_ADDRESS=0x0000000000000000000000000000000000000000
GALLEON_LENDING_RESERVE_ADDRESS=0x0000000000000000000000000000000000000000
GALLEON_DERIVATIVES_MARGIN_ADDRESS=0x0000000000000000000000000000000000000000

# Igra Sentinel Stack — copy to kaspa.env (never commit)

# Active network profile: galleon-testnet | igra-mainnet-readonly
SENTINEL_NETWORK_PROFILE=galleon-testnet

# Galleon testnet (Igra rehearsal L2)
GALLEON_RPC=https://galleon-testnet.igralabs.com:8545
GALLEON_CHAIN_ID=38836

# Igra mainnet EVM (read-only probes — no deploy keys here)
IGRA_MAINNET_RPC=https://rpc.igralabs.com:8545
IGRA_MAINNET_CHAIN_ID=38833

# WalletConnect for /ui/dex (optional)
# WALLETCONNECT_PROJECT_ID=

# Client hook gas cap (gwei)
SENTINEL_MAX_GAS_GWEI=250

# Public origin fallback. Production allowlist is sentinel.tuce.app, dex.tuce.app, cex.tuce.app.
# SENTINEL_PUBLIC_ORIGIN=https://sentinel.tuce.app

# POST rate limit (safety-verify + bridge-verify)
SENTINEL_POST_RATE_LIMIT=30
SENTINEL_POST_RATE_WINDOW=60
# Trust X-Forwarded-For only behind Caddy
# SENTINEL_TRUST_PROXY=1

# API bind
SENTINEL_API_HOST=127.0.0.1
SENTINEL_API_PORT=8790

# --- Galleon deploy / signing (local rehearsal only; private key in gitignored kaspa.env) ---
# GALLEON_PRIVATE_KEY=
# GALLEON_ADDRESS=0x0000000000000000000000000000000000000000

# --- Role wallets (private keys in gitignored kaspa.wallets.local.env — never on VPS) ---
# 20% protocol fee share (maps to LIQUIDITY_PROGRAM_PROTOCOL_TREASURY)
GALLEON_PROTOCOL_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
# 80% LP rewards pool operator / accounting (maps to LIQUIDITY_PROGRAM_CONTRIBUTORS_VAULT)
GALLEON_LP_REWARDS_POOL_ADDRESS=0x0000000000000000000000000000000000000000
# Phase 2 lending rehearsal placeholder
GALLEON_LENDING_RESERVE_ADDRESS=0x0000000000000000000000000000000000000000
# Phase 2 derivatives margin rehearsal placeholder
GALLEON_DERIVATIVES_MARGIN_ADDRESS=0x0000000000000000000000000000000000000000
